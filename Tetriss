<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Tetris</title>
<style>
  :root {
    --bg: #0f1117;
    --panel: #171a23;
    --border: #2a2f3d;
    --text: #e6e8ee;
    --muted: #8890a4;
    --accent: #6c8cff;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .game-wrap {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    padding: 20px;
  }
  .board-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px;
    position: relative;
  }
  canvas#board {
    display: block;
    background: #0a0c12;
    border-radius: 6px;
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 160px;
  }
  .card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
  }
  .card h3 {
    margin: 0 0 8px 0;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
  }
  canvas.mini {
    display: block;
    background: #0a0c12;
    border-radius: 6px;
    margin: 0 auto;
  }
  .stat {
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    margin: 4px 0;
  }
  .stat span:last-child {
    font-weight: 600;
    color: var(--accent);
  }
  .controls {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.7;
  }
  .controls b { color: var(--text); }
  .slider-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 10px;
  }
  .slider-row:last-of-type { margin-bottom: 0; }
  .slider-row label {
    font-size: 12px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
  }
  .slider-row label span {
    color: var(--accent);
    font-weight: 600;
  }
  .slider-row input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
  }
  .slider-hint {
    font-size: 11px;
    color: var(--muted);
    margin-top: 8px;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(10,12,18,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border-radius: 10px;
    text-align: center;
    gap: 10px;
  }
  .overlay.show { display: flex; }
  .overlay h2 { margin: 0; font-size: 22px; }
  .overlay p { margin: 0; color: var(--muted); font-size: 13px; }
  button {
    background: var(--accent);
    border: none;
    color: white;
    padding: 8px 18px;
    border-radius: 6px;
    font-size: 14px;
    cursor: pointer;
    font-weight: 600;
  }
  button:hover { opacity: 0.9; }
  h1 {
    font-size: 16px;
    margin: 0 0 10px 0;
    letter-spacing: 2px;
    color: var(--muted);
    text-align: center;
  }
</style>
</head>
<body>

<div class="game-wrap">
  <div class="board-panel">
    <h1>TETRIS</h1>
    <canvas id="board" width="300" height="600"></canvas>
    <div class="overlay" id="overlay">
      <h2 id="overlayTitle">Paused</h2>
      <p id="overlayText">Press Enter to resume</p>
      <button id="overlayBtn">Resume</button>
    </div>
  </div>

  <div class="side">
    <div class="card">
      <h3>Next</h3>
      <canvas class="mini" id="nextCanvas" width="120" height="80"></canvas>
    </div>
    <div class="card">
      <h3>Hold (C)</h3>
      <canvas class="mini" id="holdCanvas" width="120" height="80"></canvas>
    </div>
    <div class="card">
      <div class="stat"><span>Score</span><span id="score">0</span></div>
      <div class="stat"><span>Lines</span><span id="lines">0</span></div>
      <div class="stat"><span>Level</span><span id="level">1</span></div>
    </div>
    <div class="card controls">
      <div><b>&larr; &rarr;</b> move</div>
      <div><b>&uarr;</b> rotate</div>
      <div><b>&darr;</b> soft drop</div>
      <div><b>Space</b> hard drop</div>
      <div><b>C</b> hold / switch</div>
      <div><b>P</b> pause</div>
    </div>
    <div class="card">
      <h3>Key Repeat Speed</h3>
      <div class="slider-row">
        <label for="hRepeat">Left / Right <span id="hRepeatVal"></span></label>
        <input type="range" id="hRepeat" min="10" max="150" step="5" value="33">
      </div>
      <div class="slider-row">
        <label for="dRepeat">Soft Drop <span id="dRepeatVal"></span></label>
        <input type="range" id="dRepeat" min="10" max="150" step="5" value="28">
      </div>
      <div class="slider-hint">Lower = faster repeat while held</div>
    </div>
  </div>
</div>

<script>
(() => {
  const COLS = 10, ROWS = 20, CELL = 30;
  const canvas = document.getElementById('board');
  const ctx = canvas.getContext('2d');
  const nextCanvas = document.getElementById('nextCanvas');
  const nextCtx = nextCanvas.getContext('2d');
  const holdCanvas = document.getElementById('holdCanvas');
  const holdCtx = holdCanvas.getContext('2d');

  const scoreEl = document.getElementById('score');
  const linesEl = document.getElementById('lines');
  const levelEl = document.getElementById('level');
  const overlay = document.getElementById('overlay');
  const overlayTitle = document.getElementById('overlayTitle');
  const overlayText = document.getElementById('overlayText');
  const overlayBtn = document.getElementById('overlayBtn');

  const COLORS = {
    I: '#4dd8ff',
    J: '#4a6cff',
    L: '#ffab40',
    O: '#ffe14d',
    S: '#4dff88',
    T: '#c76bff',
    Z: '#ff4d6a'
  };

  const SHAPES = {
    I: [[0,1],[1,1],[2,1],[3,1]],
    J: [[0,0],[0,1],[1,1],[2,1]],
    L: [[2,0],[0,1],[1,1],[2,1]],
    O: [[0,0],[1,0],[0,1],[1,1]],
    S: [[1,0],[2,0],[0,1],[1,1]],
    T: [[1,0],[0,1],[1,1],[2,1]],
    Z: [[0,0],[1,0],[1,1],[2,1]]
  };

  const PIECE_NAMES = Object.keys(SHAPES);

  function rotateCells(cells) {
    // rotate around a 4x4 bounding box center-ish, standard SRS-lite
    // find bounding box
    const xs = cells.map(c => c[0]);
    const ys = cells.map(c => c[1]);
    const size = Math.max(Math.max(...xs) - Math.min(...xs), Math.max(...ys) - Math.min(...ys)) + 1;
    return cells.map(([x, y]) => [size - 1 - y, x]);
  }

  function newBag() {
    const bag = [...PIECE_NAMES];
    for (let i = bag.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [bag[i], bag[j]] = [bag[j], bag[i]];
    }
    return bag;
  }

  class Piece {
    constructor(name) {
      this.name = name;
      this.cells = SHAPES[name].map(c => [...c]);
      this.x = 3;
      this.y = 0;
      if (name === 'I') this.x = 3;
      if (name === 'O') this.x = 4;
    }
    getCells() {
      return this.cells.map(([cx, cy]) => [cx + this.x, cy + this.y]);
    }
    clone() {
      const p = new Piece(this.name);
      p.cells = this.cells.map(c => [...c]);
      p.x = this.x;
      p.y = this.y;
      return p;
    }
  }

  let grid, current, next, hold, bag, holdUsed;
  let score, lines, level, dropInterval, dropTimer, lastTime;
  let paused, gameOver, animId;
  let isClearing = false, clearingRows = [], clearingElapsed = 0;

  function init() {
    grid = Array.from({ length: ROWS }, () => Array(COLS).fill(null));
    bag = newBag();
    current = new Piece(bag.pop());
    if (bag.length === 0) bag = newBag();
    next = new Piece(bag.pop());
    hold = null;
    holdUsed = false;
    score = 0;
    lines = 0;
    level = 1;
    dropInterval = 800;
    dropTimer = 0;
    lastTime = 0;
    paused = false;
    gameOver = false;
    isClearing = false;
    clearingRows = [];
    clearingElapsed = 0;
    updateStats();
    overlay.classList.remove('show');
  }

  function updateStats() {
    scoreEl.textContent = score;
    linesEl.textContent = lines;
    levelEl.textContent = level;
  }

  function collides(piece, offX = 0, offY = 0, cellsOverride = null) {
    const cells = cellsOverride || piece.cells;
    for (const [cx, cy] of cells) {
      const x = piece.x + cx + offX;
      const y = piece.y + cy + offY;
      if (x < 0 || x >= COLS || y >= ROWS) return true;
      if (y >= 0 && grid[y][x]) return true;
    }
    return false;
  }

  function merge(piece) {
    for (const [x, y] of piece.getCells()) {
      if (y >= 0) grid[y][x] = piece.name;
    }
  }

  const CLEAR_DURATION = 320;

  function getFullRows() {
    const rows = [];
    for (let y = 0; y < ROWS; y++) {
      if (grid[y].every(cell => cell)) rows.push(y);
    }
    return rows;
  }

  function finishClear() {
    const rowsToRemove = new Set(clearingRows);
    const remaining = grid.filter((_, y) => !rowsToRemove.has(y));
    const removedCount = grid.length - remaining.length;
    const emptyRows = Array.from({ length: removedCount }, () => Array(COLS).fill(null));
    grid = emptyRows.concat(remaining);

    const count = removedCount;
    const points = [0, 100, 300, 500, 800][count] * level;
    score += points;
    lines += count;
    const newLevel = Math.floor(lines / 10) + 1;
    if (newLevel !== level) {
      level = newLevel;
      dropInterval = Math.max(100, 800 - (level - 1) * 70);
    }
    updateStats();
    isClearing = false;
    clearingRows = [];
    spawnNext();
  }

  function spawnNext() {
    current = next;
    current.x = current.name === 'O' ? 4 : 3;
    current.y = 0;
    if (bag.length === 0) bag = newBag();
    next = new Piece(bag.pop());
    holdUsed = false;
    if (collides(current)) {
      endGame();
    }
    drawNext();
  }

  function hardDrop() {
    if (paused || gameOver || isClearing) return;
    let dy = 0;
    while (!collides(current, 0, dy + 1)) dy++;
    current.y += dy;
    score += dy * 2;
    lockPiece();
  }

  function lockPiece() {
    if (isClearing) return; // never re-lock while a clear animation is in flight
    merge(current);
    const fullRows = getFullRows();
    if (fullRows.length > 0) {
      isClearing = true;
      clearingRows = fullRows;
      clearingElapsed = 0;
    } else {
      spawnNext();
    }
    dropTimer = 0;
  }

  function softDropTick() {
    if (!collides(current, 0, 1)) {
      current.y++;
      score += 1;
      updateStats();
    } else {
      lockPiece();
    }
  }

  function moveHorizontal(dir) {
    if (!collides(current, dir, 0)) current.x += dir;
  }

  function rotatePiece() {
    if (current.name === 'O') return;
    const rotated = rotateCells(current.cells);
    const kicks = [0, -1, 1, -2, 2];
    for (const k of kicks) {
      if (!collides(current, k, 0, rotated)) {
        current.cells = rotated;
        current.x += k;
        return;
      }
    }
  }

  function doHold() {
    if (holdUsed) return;
    holdUsed = true;
    if (hold === null) {
      hold = new Piece(current.name);
      spawnNext();
    } else {
      const temp = current.name;
      current = new Piece(hold.name);
      current.x = current.name === 'O' ? 4 : 3;
      current.y = 0;
      hold = new Piece(temp);
      if (collides(current)) endGame();
    }
    drawHold();
  }

  function getGhost() {
    const ghost = current.clone();
    let dy = 0;
    while (!collides(ghost, 0, dy + 1)) dy++;
    ghost.y += dy;
    return ghost;
  }

  function drawCell(c, x, y, color, alpha = 1, cellSize = CELL) {
    c.globalAlpha = alpha;
    c.fillStyle = color;
    c.fillRect(x * cellSize + 1, y * cellSize + 1, cellSize - 2, cellSize - 2);
    c.globalAlpha = 1;
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    // grid lines
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    for (let x = 0; x <= COLS; x++) {
      ctx.beginPath();
      ctx.moveTo(x * CELL, 0);
      ctx.lineTo(x * CELL, ROWS * CELL);
      ctx.stroke();
    }
    for (let y = 0; y <= ROWS; y++) {
      ctx.beginPath();
      ctx.moveTo(0, y * CELL);
      ctx.lineTo(COLS * CELL, y * CELL);
      ctx.stroke();
    }
    // locked cells (skip rows currently being cleared, drawn specially below)
    for (let y = 0; y < ROWS; y++) {
      if (isClearing && clearingRows.includes(y)) continue;
      for (let x = 0; x < COLS; x++) {
        if (grid[y][x]) drawCell(ctx, x, y, COLORS[grid[y][x]]);
      }
    }

    // line-clear flash + shrink effect
    if (isClearing) {
      const progress = Math.min(clearingElapsed / CLEAR_DURATION, 1);
      for (const y of clearingRows) {
        // bright flash across the row, fading out
        ctx.fillStyle = `rgba(255,255,255,${(1 - progress) * 0.85})`;
        ctx.fillRect(0, y * CELL, COLS * CELL, CELL);
        // blocks shrink toward the row's center and fade
        const shrink = progress;
        for (let x = 0; x < COLS; x++) {
          const color = grid[y][x];
          if (!color) continue;
          const w = (CELL - 2) * (1 - shrink);
          const cx = x * CELL + 1 + ((CELL - 2) - w) / 2;
          ctx.globalAlpha = 1 - shrink;
          ctx.fillStyle = COLORS[color];
          ctx.fillRect(cx, y * CELL + 1, w, CELL - 2);
          ctx.globalAlpha = 1;
        }
      }
    }

    // ghost + current piece (hidden while the clear animation plays)
    if (!gameOver && !isClearing) {
      const ghost = getGhost();
      for (const [x, y] of ghost.getCells()) {
        if (y >= 0) {
          ctx.strokeStyle = COLORS[current.name];
          ctx.globalAlpha = 0.7;
          ctx.lineWidth = 2;
          ctx.strokeRect(x * CELL + 2, y * CELL + 2, CELL - 4, CELL - 4);
          ctx.globalAlpha = 1;
        }
      }
      // current piece
      for (const [x, y] of current.getCells()) {
        if (y >= 0) drawCell(ctx, x, y, COLORS[current.name]);
      }
    }
  }

  function drawMini(c, canvasEl, name) {
    c.clearRect(0, 0, canvasEl.width, canvasEl.height);
    if (!name) return;
    const cells = SHAPES[name];
    const size = 18;
    const xs = cells.map(p => p[0]);
    const ys = cells.map(p => p[1]);
    const w = Math.max(...xs) - Math.min(...xs) + 1;
    const h = Math.max(...ys) - Math.min(...ys) + 1;
    const offX = (canvasEl.width - w * size) / 2 - Math.min(...xs) * size;
    const offY = (canvasEl.height - h * size) / 2 - Math.min(...ys) * size;
    for (const [x, y] of cells) {
      c.fillStyle = COLORS[name];
      c.fillRect(x * size + offX + 1, y * size + offY + 1, size - 2, size - 2);
    }
  }

  function drawNext() { drawMini(nextCtx, nextCanvas, next.name); }
  function drawHold() { drawMini(holdCtx, holdCanvas, hold ? hold.name : null); }

  function endGame() {
    gameOver = true;
    overlayTitle.textContent = 'Game Over';
    overlayText.textContent = `Score: ${score} — Press Enter to restart`;
    overlayBtn.textContent = 'Restart';
    overlay.classList.add('show');
  }

  function togglePause() {
    if (gameOver) return;
    paused = !paused;
    if (paused) {
      overlayTitle.textContent = 'Paused';
      overlayText.textContent = 'Press Enter or P to resume';
      overlayBtn.textContent = 'Resume';
      overlay.classList.add('show');
    } else {
      overlay.classList.remove('show');
      lastTime = performance.now();
    }
  }

  function loop(time) {
    if (!lastTime) lastTime = time;
    const delta = time - lastTime;
    lastTime = time;
    if (!paused && !gameOver) {
      handleKeyRepeats(delta);
      if (isClearing) {
        clearingElapsed += delta;
        if (clearingElapsed >= CLEAR_DURATION) {
          finishClear();
        }
      } else {
        dropTimer += delta;
        if (dropTimer > dropInterval) {
          dropTimer = 0;
          if (!collides(current, 0, 1)) {
            current.y++;
          } else {
            lockPiece();
          }
        }
      }
      draw();
    }
    animId = requestAnimationFrame(loop);
  }

  // --- Instant key repeat for movement (no OS auto-repeat delay) ---
  // Browser keydown auto-repeat has a built-in initial delay we can't change,
  // so we ignore repeat events for held keys and drive repeats ourselves
  // every ARR milliseconds for a snappy, delay-free feel.
  const ARR = { ArrowLeft: 33, ArrowRight: 33, ArrowDown: 28 };
  const repeatState = {};

  const hRepeatSlider = document.getElementById('hRepeat');
  const dRepeatSlider = document.getElementById('dRepeat');
  const hRepeatVal = document.getElementById('hRepeatVal');
  const dRepeatVal = document.getElementById('dRepeatVal');

  function applyRepeatSettings() {
    const h = parseInt(hRepeatSlider.value, 10);
    const d = parseInt(dRepeatSlider.value, 10);
    ARR.ArrowLeft = h;
    ARR.ArrowRight = h;
    ARR.ArrowDown = d;
    hRepeatVal.textContent = h + 'ms';
    dRepeatVal.textContent = d + 'ms';
  }
  hRepeatSlider.addEventListener('input', applyRepeatSettings);
  dRepeatSlider.addEventListener('input', applyRepeatSettings);
  applyRepeatSettings();

  function fireMoveAction(code) {
    if (isClearing || paused || gameOver) return;
    if (code === 'ArrowLeft') moveHorizontal(-1);
    else if (code === 'ArrowRight') moveHorizontal(1);
    else if (code === 'ArrowDown') softDropTick();
  }

  function handleKeyRepeats(delta) {
    for (const code in repeatState) {
      const st = repeatState[code];
      st.timer += delta;
      while (st.timer >= ARR[code]) {
        st.timer -= ARR[code];
        fireMoveAction(code);
      }
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.code === 'Enter') {
      if (e.repeat) return;
      if (gameOver) {
        init();
        drawNext();
        drawHold();
      } else {
        togglePause();
      }
      e.preventDefault();
      return;
    }
    if (gameOver || paused) {
      if (e.code === 'KeyP' && !e.repeat) togglePause();
      return;
    }

    if (ARR[e.code] !== undefined) {
      e.preventDefault();
      if (e.repeat) return; // we drive repeats ourselves, ignore OS repeat
      fireMoveAction(e.code);
      repeatState[e.code] = { timer: 0 };
      draw();
      return;
    }

    if (e.repeat) { e.preventDefault(); return; } // single-shot actions: ignore OS repeat

    switch (e.code) {
      case 'ArrowUp':
        if (!isClearing) rotatePiece();
        e.preventDefault();
        break;
      case 'Space':
        if (!isClearing) hardDrop();
        e.preventDefault();
        break;
      case 'KeyC':
        if (!isClearing) doHold();
        e.preventDefault();
        break;
      case 'KeyP':
        togglePause();
        e.preventDefault();
        break;
    }
    draw();
  });

  document.addEventListener('keyup', (e) => {
    if (repeatState[e.code]) delete repeatState[e.code];
  });

  window.addEventListener('blur', () => {
    for (const k in repeatState) delete repeatState[k];
  });

  overlayBtn.addEventListener('click', () => {
    if (gameOver) {
      init();
      drawNext();
      drawHold();
    } else {
      togglePause();
    }
  });

  init();
  drawNext();
  drawHold();
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
